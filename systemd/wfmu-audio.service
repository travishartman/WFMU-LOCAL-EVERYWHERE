[Unit]
Description=WFMU audio: Icecast relay -> USB DAC -> SI4713 line input
# Deliberately INDEPENDENT of si4713.service. The audio path (USB DAC) and the
# I2C tuning are separate hardware paths, so a slow or hung si4713 bring-up must
# not block or cancel audio startup. (A 9-min si4713 hang once caused this unit's
# queued boot job to be cancelled -> no audio.) Restart=always covers the Icecast
# relay not being up yet at boot, and a dropped stream later.
After=sound.target

[Service]
User=travis
WorkingDirectory=/home/travis/WFMU-LOCAL-EVERYWHERE
# "auto" makes play_usb_dac.sh find the USB DAC by name (in /proc/asound/cards)
# and set its volume to 100%, so a card-number shuffle on boot can't break audio.
ExecStart=/home/travis/WFMU-LOCAL-EVERYWHERE/play_usb_dac.sh http://localhost:8000/wfmu.mp3 auto
# Keep retrying: covers the Icecast relay not being up yet at boot, or a dropped stream.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
