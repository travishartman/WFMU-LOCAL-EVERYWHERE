[Unit]
Description=Spotify Connect receiver (librespot) for WFMU FM chain
After=network-online.target sound.target
Wants=network-online.target

[Service]
User=travis
WorkingDirectory=/home/travis/WFMU-LOCAL-EVERYWHERE
EnvironmentFile=-/etc/default/librespot-wfmu
ExecStart=/usr/local/bin/wfmu-start-librespot
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
