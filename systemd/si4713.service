[Unit]
Description=SI4713 FM transmitter bring-up (tune carrier + RDS on 91.1 MHz)
# I2C bus and USB must be ready; the chip itself only needs I2C.
After=multi-user.target
Wants=multi-user.target
# StartLimit* belong in [Unit], not [Service].
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=oneshot
User=travis
WorkingDirectory=/home/travis/WFMU-LOCAL-EVERYWHERE
# si4713_bringup.sh drives the RST line itself and retries once on the reset-pulse race.
ExecStart=/home/travis/WFMU-LOCAL-EVERYWHERE/si4713_bringup.sh 91.1 WFMU "WFMU live"
RemainAfterExit=yes
# Cap runtime: a wedged chip once made the first I2C attempt hang ~9 min, stalling
# boot and getting dependent jobs cancelled. If it exceeds this, systemd kills it
# and Restart=on-failure re-runs with a fresh reset (which reliably succeeds).
TimeoutStartSec=120
# If the very first boot attempt still loses the reset race, let systemd retry.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
